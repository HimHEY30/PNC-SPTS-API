NODE_ENV=development
PORT=3000
API_PREFIX=api
APP_BASE_URL=http://localhost:3000

# Swagger Portal — environment URLs (optional overrides)
SWAGGER_LOCAL_URL=http://localhost:3000/api
SWAGGER_DEV_URL=http://localhost:3000/api
SWAGGER_STAGING_URL=https://pnc-spts-stg-api.me/api
